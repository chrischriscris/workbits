# Workbits local development
# Copy to .env and adjust if needed. Defaults work with the Docker dev stack.

PORT=3101
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Dev-only overrides. Leave unset for production single-process hosting:
# the browser then uses the same origin for the API, realtime and web app.
# VITE_API_URL=http://localhost:3101
# VITE_REALTIME_URL=ws://localhost:3101
